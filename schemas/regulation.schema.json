{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://woningencheck.nl/schemas/regulation.schema.json",
    "title": "Woningencheck.nl municipal regulation record",
    "type": "object",
    "required": [
        "id",
        "municipalityCode",
        "municipalityName",
        "regulationType",
        "scopeType",
        "scopeValue",
        "shortDescription",
        "conditions",
        "exceptions",
        "officialInformationUrl",
        "officialApplicationUrl",
        "applicationUrlStatus",
        "applicationUrlVerifiedDate",
        "requiredDocuments",
        "applicationDocuments",
        "officialRegulationUrl",
        "documentIdentifier",
        "effectiveDate",
        "endDate",
        "sourcePublicationDate",
        "lastVerificationDate",
        "sourceVerificationStatus",
        "legalReviewStatus",
        "notes"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "municipalityCode": {
            "pattern": "^GM[0-9]{4}$"
        },
        "municipalityName": {
            "type": "string"
        },
        "regulationType": {
            "type": "string"
        },
        "scopeType": {
            "enum": [
                "gemeente",
                "wijk",
                "route",
                "postcode",
                "straat",
                "kaart",
                "kaart en straatquotum"
            ]
        },
        "scopeValue": {
            "type": "string"
        },
        "shortDescription": {
            "type": "string"
        },
        "conditions": {
            "type": "string"
        },
        "exceptions": {
            "type": "string"
        },
        "officialInformationUrl": {
            "type": "string",
            "format": "uri"
        },
        "officialApplicationUrl": {
            "type": ["string", "null"],
            "format": "uri"
        },
        "applicationUrlStatus": {
            "enum": ["separate-verified", "same-as-info-verified", "unresolved"]
        },
        "applicationUrlVerifiedDate": {
            "type": ["string", "null"],
            "format": "date"
        },
        "requiredDocuments": {
            "type": "array",
            "items": {"type": "string"}
        },
        "applicationDocuments": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["label", "url"],
                "properties": {
                    "label": {"type": "string"},
                    "url": {"type": "string", "format": "uri"}
                },
                "additionalProperties": false
            }
        },
        "officialRegulationUrl": {
            "type": "string",
            "format": "uri"
        },
        "documentIdentifier": {
            "type": "string"
        },
        "effectiveDate": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "endDate": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "sourcePublicationDate": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "lastVerificationDate": {
            "type": "string",
            "format": "date"
        },
        "sourceVerificationStatus": {
            "enum": [
                "not verified",
                "official source found \u2014 automated recheck pending",
                "official regulation found \u2014 municipal URL requires automated recheck",
                "verified live",
                "conflict \u2014 manual review required"
            ]
        },
        "legalReviewStatus": {
            "enum": [
                "not reviewed",
                "in review",
                "approved",
                "rejected",
                "conflict \u2014 manual review required"
            ]
        },
        "notes": {
            "type": "string"
        }
    },
    "additionalProperties": false
}
