{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woningencheck.nl/schemas/regulation.schema.json",
  "title": "Woningencheck.nl municipal regulation record",
  "type": "object",
  "required": [
    "id",
    "municipalityCode",
    "municipalityName",
    "title",
    "regulationType",
    "scopeType",
    "scopeValue",
    "shortDescription",
    "conditions",
    "exceptions",
    "officialInformationUrl",
    "officialApplicationUrl",
    "applicationUrlStatus",
    "applicationUrlVerifiedDate",
    "requiredDocuments",
    "applicationDocuments",
    "officialRegulationUrl",
    "documentIdentifier",
    "effectiveDate",
    "endDate",
    "sourcePublicationDate",
    "lastVerificationDate",
    "sourceVerificationStatus",
    "legalReviewStatus",
    "canonicalType",
    "municipalName",
    "temporal",
    "verification",
    "evidence",
    "conflictStatus",
    "conflicts",
    "geographicScopeReview",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "municipalityCode": {
      "pattern": "^GM[0-9]{4}$"
    },
    "municipalityName": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "regulationType": {
      "type": "string"
    },
    "scopeType": {
      "enum": [
        "gemeente",
        "wijk",
        "route",
        "postcode",
        "straat",
        "kaart",
        "kaart en straatquotum"
      ]
    },
    "scopeValue": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "conditions": {
      "type": "string"
    },
    "exceptions": {
      "type": "string"
    },
    "officialInformationUrl": {
      "type": "string",
      "format": "uri"
    },
    "officialApplicationUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "applicationUrlStatus": {
      "enum": [
        "separate-verified",
        "same-as-info-verified",
        "unresolved"
      ]
    },
    "applicationUrlVerifiedDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "requiredDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "requirement",
          "description",
          "officialInstructionsUrl",
          "officialTemplateUrl",
          "onlineFormUrl",
          "responsibleAuthority",
          "lastVerifiedAt",
          "classification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "requirement": {
            "enum": [
              "required",
              "conditional"
            ]
          },
          "description": {
            "type": "string"
          },
          "officialInstructionsUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "officialTemplateUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "onlineFormUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "responsibleAuthority": {
            "type": "string"
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date"
          },
          "classification": {
            "enum": [
              "official-form",
              "official-template",
              "official-instruction",
              "user-supplied-document",
              "external-official-document"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "applicationDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "url",
          "classification",
          "responsibleAuthority",
          "lastVerifiedAt"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "classification": {
            "enum": [
              "official-form",
              "official-template",
              "official-instruction",
              "external-official-document"
            ]
          },
          "responsibleAuthority": {
            "type": "string"
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "officialRegulationUrl": {
      "type": "string",
      "format": "uri"
    },
    "documentIdentifier": {
      "type": "string"
    },
    "effectiveDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "endDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sourcePublicationDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "lastVerificationDate": {
      "type": "string",
      "format": "date"
    },
    "sourceVerificationStatus": {
      "enum": [
        "not verified",
        "official source found — automated recheck pending",
        "official regulation found — municipal URL requires automated recheck",
        "verified live",
        "conflict — manual review required"
      ]
    },
    "legalReviewStatus": {
      "enum": [
        "not reviewed",
        "in review",
        "approved",
        "rejected",
        "conflict — manual review required"
      ]
    },
    "canonicalType": {
      "type": "string"
    },
    "municipalName": {
      "type": "string"
    },
    "temporal": {
      "type": "object",
      "required": [
        "validFrom",
        "validUntil",
        "supersededBy",
        "previousVersion",
        "lastCheckedAt",
        "status"
      ],
      "properties": {
        "validFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "validUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "supersededBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "previousVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "current",
            "current-candidate",
            "future",
            "expired",
            "revoked",
            "uncertain"
          ]
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "url",
        "source",
        "content",
        "currentness",
        "application",
        "documents",
        "legalReview"
      ],
      "additionalProperties": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "conflictStatus": {
      "enum": [
        "none-found",
        "conflict — manual review required"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "geographicScopeReview": {
      "enum": [
        "structured-candidate",
        "verified",
        "manual-review-required",
        "fully-verified",
        "partially-verified"
      ]
    },
    "notes": {
      "type": "string"
    },
    "applicability": {
      "type": "object",
      "required": [
        "version",
        "conclusiveWhenMatched",
        "matchMessage",
        "geographicNoMatchMessage",
        "conditions"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "conclusiveWhenMatched": {
          "type": "boolean"
        },
        "matchMessage": {
          "type": "string"
        },
        "geographicNoMatchMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "category",
              "conditionType",
              "source",
              "operator",
              "evidenceUrl",
              "evidenceSection"
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "geographicScope": {
      "type": "object",
      "required": [
        "operator",
        "conditions",
        "validFrom",
        "sourceVersion",
        "lastVerifiedDate"
      ],
      "properties": {
        "operator": {
          "enum": [
            "AND",
            "OR"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "validFrom": {
          "type": [
            "string",
            "null"
          ]
        },
        "validUntil": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersededBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceVersion": {
          "type": "string"
        },
        "lastVerifiedDate": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
