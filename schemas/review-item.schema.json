{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual review queue item",
  "type": "object",
  "required": [
    "id",
    "municipalityCode",
    "regulationId",
    "category",
    "reason",
    "status",
    "priority",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "municipalityCode": {
      "pattern": "^GM[0-9]{4}$"
    },
    "regulationId": {
      "type": "string"
    },
    "category": {
      "enum": [
        "legal-interpretation",
        "geographic-scope",
        "effective-date",
        "application-route",
        "required-documents",
        "source-conflict",
        "manual-pdf",
        "map-interpretation",
        "official-map-needs-gis-digitisation"
      ]
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "in-review",
        "resolved",
        "wont-fix"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
