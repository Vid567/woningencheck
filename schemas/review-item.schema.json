{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual review queue item",
  "type": "object",
  "required": [
    "id",
    "municipalityCode",
    "regulationId",
    "category",
    "reason",
    "status",
    "priority",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "municipalityCode": {
      "pattern": "^GM[0-9]{4}$"
    },
    "regulationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "enum": [
        "legal-interpretation",
        "geographic-scope",
        "effective-date",
        "application-route",
        "required-documents",
        "source-conflict",
        "manual-pdf",
        "map-interpretation",
        "official-map-needs-gis-digitisation",
        "source-completeness",
        "taxonomy",
        "legal-and-source",
        "legal-and-gis"
      ]
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "in-review",
        "resolved",
        "wont-fix"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "resolution": {
      "type": "string"
    },
    "resolvedAt": {
      "type": "string",
      "format": "date"
    },
    "decisiveSources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "string"
    },
    "blockerClass": {
      "enum": [
        "release-batch-blocker",
        "municipality-specific-blocker",
        "non-blocking-review",
        "non-blocking-resolved"
      ]
    },
    "resolutionType": {
      "type": "string"
    },
    "publicImpact": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "exactQuestion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
